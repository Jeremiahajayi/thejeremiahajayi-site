{
  // Cloudflare Worker: redirects the bare domain to www, then serves the built site in dist/
  "name": "thejeremiahajayi-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
